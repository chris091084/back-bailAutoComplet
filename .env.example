# =============================================================================
# Gabarit de configuration — copier tel quel pour démarrer en local :
#
#     cp .env.example .env
#
# Les valeurs ci-dessous suffisent à faire tourner l'API en développement,
# aucune n'est secrète. Le vrai .env n'est pas versionné (cf. .gitignore).
# =============================================================================

# --- Base de données (développement local) -----------------------------------
# Postgres vient du docker-compose du projet front (bailAutoComplete-Front) :
#
#     docker start bailautocomplete-front-db-1
#
# Il publie sur 5433, et non 5432 où un autre Postgres écoute déjà.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=root
DB_NAME=bailautocomplet_dev

# Première installation : créer la base puis laisser les migrations la remplir.
#
#     docker exec -e PGPASSWORD=root bailautocomplete-front-db-1 \
#       psql -U postgres -c "CREATE DATABASE bailautocomplet_dev;"
#     npm run migration:run

# --- Base de données (production) --------------------------------------------
# DATABASE_URL prend le pas sur les cinq variables ci-dessus. Deux formes
# acceptées :
#   postgres://user:password@hote:5432/base          (fourni par Render)
#   jdbc:postgresql://hote:5432/base?user=…&password=…   (ancien format Koyeb)
# DATABASE_URL=
# DB_SSL=true

# --- Comportement de l'ORM ---------------------------------------------------
# Applique les migrations au démarrage, comme le faisait Liquibase.
# À passer à false sur une base construite par Liquibase tant que
# `npm run migration:baseline` n'a pas été lancé dessus.
DB_MIGRATIONS_RUN=true
# Trace le SQL exécuté.
DB_LOGGING=false

# --- API ---------------------------------------------------------------------
# Le code écoute sur 8080 par défaut, et c'est ce que la production utilise
# (cf. EXPOSE 8080 du Dockerfile). En local on décale sur 8081 : un conteneur
# Authentik, lancé par le démon Docker SYSTÈME (root), occupe 8080 en permanence
# et n'apparaît pas dans `docker ps` — il faut `sudo docker ps` pour le voir.
# Symptôme si on repasse à 8080 : `Error: listen EADDRINUSE ... 0.0.0.0:8080`.
PORT=8081
# Origine autorisée en CORS : c'est l'origine du FRONT (Angular sur 4200), pas
# celle de l'API — elle ne change pas quand on décale le port de l'API.
CORS_ORIGIN=http://localhost:4200
# Délai au bout duquel `GET /actuator/health/readiness` renvoie 503 plutôt que
# d'attendre la base. Le front repolle : mieux vaut une réponse rapide « pas
# encore prêt » qu'une requête qui pend pendant le réveil de l'instance.
READINESS_TIMEOUT_MS=4000

# --- Authentification --------------------------------------------------------
# L'API n'a qu'un seul compte, protégé par un mot de passe unique. Il n'y a ni
# email, ni inscription : personne ne peut créer de compte.
#
# Le mot de passe ne se configure PAS ici : il vit haché en base, et s'y écrit
# uniquement depuis un terminal local :
#
#     npm run auth:seed
#
# Le script demande le mot de passe (saisie masquée), le hache en bcrypt et
# l'écrit en base. AUCUNE route HTTP ne permet de le définir ni de le modifier —
# c'est délibéré. Relancez simplement le script pour en changer : les sessions
# ouvertes sont révoquées au passage.
#
# Tant qu'aucun mot de passe n'a été semé, /auth/login refuse toute connexion et
# l'API le signale par un avertissement au démarrage.

# Clés de signature des JWT. DEUX valeurs DIFFÉRENTES : un refresh token ne doit
# jamais pouvoir être présenté comme un access token. Générer chacune avec :
#
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# En production, ce sont des secrets : ils ne se versionnent pas. Les changer
# invalide toutes les sessions en cours.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Durées de vie des jetons, en secondes. Servent à la fois d'expiration au JWT et
# de maxAge au cookie. Défauts : 15 minutes et 7 jours.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# --- Cookies -----------------------------------------------------------------
# Les jetons ne transitent QUE par cookies httpOnly, jamais dans le JSON.
#
# COOKIE_SECURE : cookies réservés à HTTPS. Défaut : true si NODE_ENV=production,
# false sinon — donc rien à régler en local.
# COOKIE_SECURE=true
#
# COOKIE_SAMESITE : strict | lax | none. Défaut strict.
#   Le port ne compte pas dans la notion de site : localhost:4200 → localhost:8080
#   fonctionne en strict. En revanche, si le front et l'API sont déployés sur DEUX
#   DOMAINES DIFFÉRENTS, il faut impérativement none + COOKIE_SECURE=true (HTTPS),
#   sinon le navigateur ignore les cookies sans afficher d'erreur.
# COOKIE_SAMESITE=none
#
# COOKIE_DOMAIN : à ne renseigner que pour partager les cookies entre
# sous-domaines (ex. .mondomaine.fr).
# COOKIE_DOMAIN=

# --- API INSEE BDM -----------------------------------------------------------
# Récupération automatique de l'IRL, service SDMX public, sans clé.
# Ces trois valeurs ont déjà ces défauts dans le code : ne les surcharger que
# pour changer de série ou d'endpoint.
INSEE_BDM_BASE_URL=https://www.bdm.insee.fr/series/sdmx/data/SERIES_BDM
INSEE_IRL_IDBANK=001515333
INSEE_IRL_CACHE_TTL_HOURS=6
